<div class="list-items">
  @foreach{item : listItems}
    @code{resultType = item.infoType.toString()}
    @if{resultType == "STREAM"}
      @code{target = linkUtility.buildStreamUrl(item.url)}
    @else{resultType == "CHANNEL"}
      @code{target = linkUtility.buildChannelUrl(item.url)}
    @else{resultType == "PLAYLIST"}
      @code{target = linkUtility.buildPlaylistUrl(item.url)}
    @else{resultType == "COMMENT"}
      @code{target = linkUtility.buildChannelUrl(item.getUploaderUrl())}
    @else{}
      @code{target = null}
    @end{}

    <!--<p>@{item.url}</p>-->
    <div class="list-item">
      <!--@if{resultType == "STREAM"}
      @else{resultType == "CHANNEL"}
      @else{resultType == "PLAYLIST"}
      @else{resultType == "COMMENT"}
      @else{}
      @end{}-->

      <img
        srcset="@{templateUtility.buildImageSrcset(item.getThumbnails())}" alt="thumbnail"
        loading="lazy"
      />
      <div class="details">
        @if{target == null}
          <span>@{item.name}</span>
        @else{}
          <a href="@{target}">@{item.name}</a>
        @end{}
        <div class="secondary-details">
          @if{resultType == "STREAM"}
            <span>@{item.uploaderName}</span>
            @code{views = templateUtility.truncateNumber(item.viewCount)}
            @if{item.getStreamType().toString() == "LIVE_STREAM"}
              <span>@{views} viewers</span>
            @else{}
              <span>@{views} views - @{item.textualUploadDate}</span>
            @end{}
          @else{resultType == "CHANNEL"}
            <span>@{item.getDescription()}</span>
            <span>@{templateUtility.truncateNumber(item.getSubscriberCount())} subscribers</span>
          @else{resultType == "PLAYLIST"}
            <p>PLAYLIST</p>
          @else{resultType == "COMMENT"}
            <p>@{item.getCommentText().getContent()}</p>
            <div>
              @{templateUtility.icon("thumb_up", "")} @{templateUtility.truncateNumber(extractor.getLikeCount())}
            </div>
          @else{}
          @end{}
        </div>
      </div>
    </div>

    <!-- TODO: fill these out in the handler -->
    <!--<div
      hx-trigger="click"
      @if{item.infoType.toString() == "STREAM"}
        hx-get="/watch/@{item.url.substring(item.url.lastIndexOf("=") + 1)}"
        class="result stream-result"
      @else{item.infoType.toString() == "CHANNEL"}
        hx-get="/channel@{item.url.substring(item.url.lastIndexOf("/"))}"
        class="result channel-result"
      @else{item.infoType.toString() == "PLAYLIST"}
        hx-get="@{item.url}"
        class="result playlist-result"
      @else{}
        class="result unknown-result"
      @end{}
    >
      <img
        srcset="
          @foreach{thumbnail : item.thumbnails}
            @{thumbnail.url} @{thumbnail.width}w
          @end{","}
        "
        alt="thumbnail"
      />
      <p>@{item.name}</p>
      @if{item.infoType.toString() == "STREAM"}
        <p>@{item.uploaderName}</p>
        <p>@{item.viewCount} - @{item.textualUploadDate}</p>
      @end{}

      <pre>@{item}</pre>
      <br>
    </div>-->
  @end{}
</div>

@if{paginationPath != null}
  <div
    hx-target="this"
    hx-swap="outerHTML"
  >
  <!--<div
    hx-get="{paginationPath}?query=@{query}&page=@{pageNum + 1}"
    hx-target="this"
    hx-swap="outerHTML"
    hx-trigger="revealed"
  >-->
    <!-- fallback in case js is disabled -->
    <form action="@{paginationPath}" target="_SELF" method="GET">
      @if{paginationContext.metadata != null}
        @foreach{pair : paginationContext.metadata.entrySet()}
          <input type="hidden" name="@{pair.key}" value="@{pair.value}" />
        @end{}
      @end{}
      <input name="page" type="hidden" value="@{pageNum + 1}" />
      <button type="submit">Next Page</button>
    </form>
  </div>
@end{}
