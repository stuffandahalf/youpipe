@foreach{panel : tabPanels}
  <input type="radio" name="tab" id="tab-@{panel.name}" class="tab-radio" @if{panel.active}checked="checked"@end{} />
@end{}
<div class="tabs">
  @foreach{panel : tabPanels}
    <label for="tab-@{panel.name}">@{panel.name}</label>
  @end{}
</div>

@foreach{panel : tabPanels}
  <section id="panel-@{panel.name}" class="panel">@{panel.html}</section>
@end{}

<style>
.tab-radio {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.tabs {
  display: flex;
  margin-bottom: var(--space-1);
}

.tabs label {
  flex: 1;
  text-align: center;
  cursor: pointer;
  padding: var(--space-1);
  border: 1px solid var(--theme-primary);
}

.tabs label + label {
  margin-left: var(--space-1);
}

@foreach{panel : tabPanels}
#tab-@{panel.name}:checked ~ .tabs label[for="tab-@{panel.name}"] {
  background-color: var(--theme-primary);
}
@end{}

.panel {
  display: none;
}

@foreach{panel : tabPanels}
#tab-@{panel.name}:checked ~ #panel-@{panel.name} {
  display: block;
}
@end{}
</style>
