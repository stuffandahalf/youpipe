<!DOCTYPE html>

<html lang="en">
  <head>
    @if{!isFragment || pageTemplate == null}
      <title>YouPipe</title>
    @end{}

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />

    <!-- common css rules -->
    <style>
      :root {
        --theme-primary: #952922;
        --theme-secondary: #252024;
        --text-primary: white;
        --text-secondary: lightgrey;

        --space-1: 5px;
        --space-2: calc(var(--space-1) * 2);
        --space-3: calc(var(--space-1) * 3);
      }

      .material-symbols-outlined {
        vertical-align: text-bottom;
      }

      /* sitewide colours */
      body, a {
        color: var(--text-primary);
      }

      body {
        font-family: Arial, sans-serif;
        margin: 0px;
        background-color: var(--theme-secondary);
      }

      form {
        input, button, select {
          &, & * {
            color: revert;
          }
        }
      }

      /* loading indicator */
      @keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .htmx-indicator {
        display: inline-block;
        animation: rotate 2s linear infinite;
      }

      /* layout */
      nav, main, footer {
        padding: var(--space-2); 
      }

      div {
        display: flex;
      }

      nav {
        background-color: var(--theme-primary);

        position: sticky;
        top: 0;

        display: flex;
        justify-content: space-between;
        align-items: center;

        .nav-section > * {
          margin-left: var(--space-1);
          margin-right: var(--space-1);
        }
      }

      footer section {
        display: flex;

        a {
          margin-right: var(--space-2);
        }
      }

      /* common template pattern */
      .no-style {
        background-color: inherit;
        color: inherit;
        border: none;
        padding: 0;
        margin: 0;
      }

      .list-items {
        /*flex-direction: row;*/
        flex-wrap: wrap;

        .list-item {
          align-items: center;
          &:not(:last-child) {
            margin-bottom: var(--space-2);
          }

          img {
            width: 25%;
            flex-shrink: 0;
            margin-right: var(--space-1);
          }
          .details {
            flex-direction: column;
          }
          .secondary-details {
            flex-direction: column;
            color: var(--text-secondary);
          }
        }
      }

      img.channel-avatar, img.stream-thumbnail {
        height: 5rem;
      }
    </style>
  </head>
  <body hx-target="main" hx-swap="innerHTML show:no-scroll" hx-boost="true" hx-indicator=".htmx-indicator">
    <nav>
      <div class="nav-section">
        <a href="/">@{templateUtility.icon("home", "Home")}</a>
        <span class="htmx-indicator">@{templateUtility.icon("progress_activity", "Loading")}</span>
      </div>
      <div class="nav-section">
        <a href="/subscriptions">Subscriptions</a>
        <a href="/playlists">Playlists</a>
      </div>
      <div class="nav-section">
        <a href="/search">@{templateUtility.icon("search", "Search")}</a>
        <a href="/settings">@{templateUtility.icon("settings", "Settings")}</a>
      </div>
    </nav>
    <main hx-history-elt>
      @if{!isFragment && pageTemplate != null}
        @{templateLoader.load(pageTemplate)}
      @else{}
        @{templateLoader.load("home")}
      @end{}
    </main>
    <footer>
      <hr />
      <p>Copyright (C) 2026 Gregory Norton</p>
      <p>YouTube (C) is a copyright of Google LLC</p>
      <section>
        <a href="https://github.com/stuffandahalf/youpipe" target="_BLANK">GitHub</a>
        <a href="https://github.com/TeamNewPipe/NewPipeExtractor" target="_BLANK">NewPipeExtractor</p>
      </section>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
  </body>
</html>
